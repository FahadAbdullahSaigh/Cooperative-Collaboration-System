
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// تحديث حالة الطلب عند الضغط على قبول أو رفض
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $id = (int) ($_POST["application_id"] ?? 0);
    $status = $_POST["status"] ?? "";

    // الحالات المسموح بها
    $allowedStatuses = ["Pending", "Approved", "Rejected"];

    if ($id > 0 && in_array($status, $allowedStatuses, true)) {

        $stmt = $conn->prepare(
            "UPDATE training_applications
             SET status = :status
             WHERE application_id = :id"
        );

        $stmt->execute([
            ":status" => $status,
            ":id" => $id
        ]);
    }

    // الرجوع للصفحة بعد تحديث الحالة
    header("Location: application.php");
    exit;
}

// جلب الطلبات مع أسماء الطلاب وجهات التدريب
$sql = "SELECT
            a.application_id,
            s.full_name,
            c.company_name,
            a.application_date,
            a.start_date,
            a.end_date,
            a.status
        FROM training_applications a
        INNER JOIN students s
            ON a.student_id = s.student_id
        INNER JOIN training_companies c
            ON a.company_id = c.company_id
        ORDER BY a.application_id DESC";

$stmt = $conn->query($sql);
$applications = $stmt->fetchAll(PDO::FETCH_ASSOC);

// تحويل الحالة إلى العربية
$statusNames = [
    "Pending" => "قيد الانتظار",
    "Approved" => "مقبول",
    "Rejected" => "مرفوض",
    "Completed" => "مكتمل"
];
?>

