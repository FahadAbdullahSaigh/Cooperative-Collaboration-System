
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// متغير لرسالة النتيجة
$message = "";

// جلب الطلاب المسجلين
$students = $conn->query(
    "SELECT student_id, full_name, student_number
     FROM students ORDER BY full_name"
)->fetchAll(PDO::FETCH_ASSOC);

// جلب جهات التدريب المسجلة
$companies = $conn->query(
    "SELECT company_id, company_name
     FROM training_companies ORDER BY company_name"
)->fetchAll(PDO::FETCH_ASSOC);

// التحقق من إرسال نموذج الطلب
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استقبال البيانات
    $student_id = $_POST["student_id"] ?? "";
    $company_id = $_POST["company_id"] ?? "";
    $start_date = $_POST["start_date"] ?? "";
    $end_date = $_POST["end_date"] ?? "";

    // التأكد من اختيار الطالب والجهة والتواريخ
    if (
        $student_id === "" ||
        $company_id === "" ||
        $start_date === "" ||
        $end_date === ""
    ) {
        $message = "فضلاً أكمل جميع الحقول.";

    } elseif ($end_date < $start_date) {

        // تاريخ النهاية يجب ألا يسبق تاريخ البداية
        $message = "تاريخ نهاية التدريب يجب أن يكون بعد تاريخ البداية.";

    } else {

        try {
            // تجهيز أمر حفظ طلب التدريب
            $sql = "INSERT INTO training_applications
                    (student_id, company_id, application_date,
                     start_date, end_date, status)
                    VALUES
                    (:student_id, :company_id, CURDATE(),
                     :start_date, :end_date, 'Pending')";

            $stmt = $conn->prepare($sql);

            // حفظ الطلب في قاعدة البيانات
            $stmt->execute([
                ":student_id" => $student_id,
                ":company_id" => $company_id,
                ":start_date" => $start_date,
                ":end_date" => $end_date
            ]);

            $message = "تم تقديم طلب التدريب بنجاح ✅";

        } catch (PDOException $e) {

            // تسجيل الخطأ في سجل الخادم دون عرضه للمستخدم
            error_log($e->getMessage());
            $message = "تعذر حفظ الطلب. تأكد من صحة البيانات وحاول مرة أخرى.";
        }
    }
}
