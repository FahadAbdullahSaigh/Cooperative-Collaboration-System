
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// جلب الطلاب من قاعدة البيانات
$stmt = $conn->query(
    "SELECT student_id, full_name FROM students ORDER BY full_name"
);
$students = $stmt->fetchAll(PDO::FETCH_ASSOC);

// عند إرسال النموذج
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استلام البيانات من النموذج
    $student_id = (int) ($_POST["student_id"] ?? 0);
    $report_title = trim($_POST["report_title"] ?? "");
    $report_description = trim($_POST["report_description"] ?? "");
    $submission_date = $_POST["submission_date"] ?? "";

    // التأكد من إدخال البيانات المطلوبة
    if (
        $student_id > 0 &&
        $report_title !== "" &&
        $submission_date !== ""
    ) {
        // حفظ التقرير في قاعدة البيانات
        $stmt = $conn->prepare(
            "INSERT INTO reports
            (student_id, report_title, report_description,
             submission_date, status)
            VALUES
            (:student_id, :report_title, :report_description,
             :submission_date, 'Pending')"
        );

        $stmt->execute([
            ":student_id" => $student_id,
            ":report_title" => $report_title,
            ":report_description" => $report_description,
            ":submission_date" => $submission_date
        ]);

        // الانتقال إلى صفحة التقارير بعد الحفظ
        header("Location: reports.php");
        exit;
    }

    $error = "فضلاً، عبّئ جميع الحقول المطلوبة.";
}
?>

