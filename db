<?php
// =====================================================
// الاتصال بقاعدة البيانات
// Database Connection
// =====================================================

// اسم السيرفر
$host = "localhost";

// اسم قاعدة البيانات
$dbname = "cooperative_training_db";

// اسم مستخدم MySQL في WAMP
$username = "root";

// كلمة المرور
// غالباً تكون فارغة في WAMP إذا لم تقم بتغييرها
$password = "";


try {

    // إنشاء الاتصال بقاعدة البيانات
    $conn = new PDO(
        "mysql:host=$host;dbname=$dbname;charset=utf8mb4",
        $username,
        $password
    );

    // إظهار الأخطاء في حالة حدوث مشكلة
    $conn->setAttribute(
        PDO::ATTR_ERRMODE,
        PDO::ERRMODE_EXCEPTION
    );

} catch (PDOException $e) {

    // إظهار رسالة في حالة فشل الاتصال
    die("فشل الاتصال بقاعدة البيانات: " . $e->getMessage());

}
?>
