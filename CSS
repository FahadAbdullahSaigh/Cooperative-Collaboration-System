
/* الإعدادات العامة */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f0f4f9;
    color: #24415e;
    text-align: center;
    line-height: 1.6;
}

/* رأس الموقع */
.header {
    background: #194c73;
    color: white;
    padding: 22px 15px;
}

.header h1 {
    font-size: 28px;
}

.header p {
    margin-top: 5px;
    font-size: 17px;
}

/* مساحة المحتوى */
.container {
    width: 90%;
    max-width: 1050px;
    margin: 35px auto;
}

/* العناوين */
h1 {
    color: #194c73;
    margin: 25px 10px 15px;
}

h2 {
    color: #194c73;
    margin: 20px 0;
}

/* بطاقات الإحصائيات */
.stats {
    width: 90%;
    max-width: 1050px;
    margin: 30px auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.card,
.stat-card {
    background: white;
    border: 1px solid #d4e1ef;
    border-radius: 10px;
    padding: 22px 15px;
    min-height: 125px;
    box-shadow: 0 2px 8px #00000008;
}

.card {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 12px;
}

.card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 65px;
    height: 65px;
    flex-shrink: 0;
    background: #e6eff9;
    border-radius: 50%;
    font-size: 29px;
}

.card h3,
.stat-card h3 {
    font-size: 17px;
    margin-bottom: 8px;
}

.card p,
.stat-card p {
    font-size: 28px;
    font-weight: bold;
    color: #194c73;
    margin: 8px 0;
}

/* روابط الإحصائيات */
.card a,
.stat-card a {
    color: #194c73;
    text-decoration: none;
    font-weight: bold;
}

.card a:hover,
.stat-card a:hover {
    text-decoration: underline;
}

/* روابط النظام */
.navigation h2 {
    margin-bottom: 22px;
    font-size: 25px;
}

.links,
.dashboard-links {
    width: 90%;
    max-width: 1050px;
    margin: 25px auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
}

.menu-card,
.dashboard-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 250px;
    min-height: 65px;
    padding: 15px;
    background: white;
    color: #194c73;
    border: 1px solid #194c73;
    border-radius: 8px;
    text-decoration: none;
    font-size: 16px;
    font-weight: bold;
    transition: 0.2s;
}

.menu-card span {
    font-size: 25px;
}

.menu-card:hover,
.dashboard-links a:hover {
    background: #194c73;
    color: white;
    transform: translateY(-2px);
}

/* روابط الصفحات الداخلية */
body > p {
    margin: 12px;
}

body > p a {
    color: #194c73;
    text-decoration: none;
    font-weight: bold;
}

body > p a:hover {
    text-decoration: underline;
}

/* النماذج */
form {
    width: 90%;
    max-width: 480px;
    margin: 20px auto;
    padding: 24px;
    background: white;
    border-radius: 10px;
    text-align: right;
    box-shadow: 0 2px 8px #0000000a;
}

label {
    display: block;
    margin: 12px 0 5px;
    font-weight: bold;
}

input,
select,
textarea {
    width: 100%;
    padding: 11px;
    border: 1px solid #ccd8e5;
    border-radius: 6px;
    font-family: Arial, sans-serif;
    font-size: 15px;
    margin-bottom: 8px;
}

button {
    width: 100%;
    padding: 12px;
    margin-top: 12px;
    background: #194c73;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 16px;
    cursor: pointer;
}

button:hover {
    background: #123753;
}

/* الجداول */
table {
    width: 95%;
    max-width: 1100px;
    margin: 25px auto;
    border-collapse: collapse;
    background: white;
    box-shadow: 0 2px 8px #00000008;
}

th,
td {
    padding: 11px;
    border: 1px solid #dce5ef;
    overflow-wrap: anywhere;
}

th {
    background: #194c73;
    color: white;
}

td form {
    width: auto;
    margin: 4px;
    padding: 0;
    box-shadow: none;
    background: transparent;
}

/* أسفل الموقع */
footer {
    margin-top: 45px;
    padding: 18px;
    border-top: 1px solid #dce5ef;
    color: #647b92;
    font-size: 14px;
}

/* عرض الجوال */
@media (max-width: 700px) {
    .header h1 {
        font-size: 22px;
    }

    .container,
    .stats,
    .links,
    .dashboard-links {
        width: 94%;
    }

    .stats {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .card {
        justify-content: space-between;
    }

    .menu-card,
    .dashboard-links a {
        width: 100%;
    }

    table {
        display: block;
        overflow-x: auto;
        font-size: 12px;
    }

    th,
    td {
        padding: 7px;
    }
}
