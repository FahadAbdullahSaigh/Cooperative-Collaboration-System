
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// تغيير حالة التقرير عند الضغط على أحد الأزرار
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $report_id = (int) ($_POST["report_id"] ?? 0);
    $status = $_POST["status"] ?? "";

    // الحالات المسموح بها
    $allowedStatuses = ["Pending", "Approved", "Rejected"];

    if ($report_id > 0 && in_array($status, $allowedStatuses, true)) {

        // تحديث حالة التقرير
        $stmt = $conn->prepare(
            "UPDATE reports
             SET status = :status
             WHERE report_id = :id"
        );

        $stmt->execute([
            ":status" => $status,
            ":id" => $report_id
        ]);
    }

    // الرجوع إلى صفحة التقارير
    header("Location: reports.php");
    exit;
}

// جلب التقارير مع أسماء الطلاب
$sql = "SELECT
            r.report_id,
            r.report_title,
            r.report_description,
            r.submission_date,
            r.status,
            s.full_name
        FROM reports r
        INNER JOIN students s
            ON r.student_id = s.student_id
        ORDER BY r.report_id DESC";

$stmt = $conn->query($sql);
$reports = $stmt->fetchAll(PDO::FETCH_ASSOC);

// ترجمة الحالات إلى العربية
$statusNames = [
    "Pending" => "قيد المراجعة",
    "Approved" => "مقبول",
    "Rejected" => "مرفوض"
];
?>

