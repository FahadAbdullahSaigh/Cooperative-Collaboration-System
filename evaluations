
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// جلب التقييمات مع أسماء الطلاب والمشرفين
$sql = "SELECT
            e.evaluation_id,
            s.full_name AS student_name,
            sup.full_name AS supervisor_name,
            e.evaluation_score,
            e.comments,
            e.evaluation_date
        FROM evaluations e
        INNER JOIN students s
            ON e.student_id = s.student_id
        INNER JOIN supervisors sup
            ON e.supervisor_id = sup.supervisor_id
        ORDER BY e.evaluation_id DESC";

$stmt = $conn->query($sql);
$evaluations = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>

