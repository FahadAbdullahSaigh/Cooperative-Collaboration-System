
<?php
// استدعاء ملف الاتصال بقاعدة البيانات
require_once "db.php";

// متغير لتخزين رسالة النتيجة
$message = "";

// التأكد أن المستخدم أرسل النموذج
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استقبال البيانات من النموذج وتنظيف المسافات
    $student_number = trim($_POST["student_number"] ?? "");
    $full_name = trim($_POST["full_name"] ?? "");
    $email = trim($_POST["email"] ?? "");
    $phone = trim($_POST["phone"] ?? "");
    $major = trim($_POST["major"] ?? "");

    // التأكد أن الحقول الأساسية ليست فارغة
    if ($student_number === "" || $full_name === "" || $email === "") {

        $message = "فضلاً عبّئ الرقم التدريبي والاسم والبريد الإلكتروني.";

    } else {

        try {
            // تجهيز أمر SQL لإضافة الطالب
            $sql = "INSERT INTO students
                    (student_number, full_name, email, phone, major)
                    VALUES
                    (:student_number, :full_name, :email, :phone, :major)";

            $stmt = $conn->prepare($sql);

            // ربط بيانات النموذج بأمر SQL
            $stmt->execute([
                ":student_number" => $student_number,
                ":full_name" => $full_name,
                ":email" => $email,
                ":phone" => $phone,
                ":major" => $major
            ]);

            $message = "تمت إضافة الطالب بنجاح ✅";

        } catch (PDOException $e) {

            // معالجة تكرار الرقم التدريبي
            if ($e->getCode() == "23000") {
                $message = "خطأ: الرقم التدريبي مستخدم من قبل.";
            } else {
                $message = "حدث خطأ أثناء إضافة الطالب.";
            }
        }
    }
}
?>

