
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// التحقق من إرسال النموذج
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استلام بيانات المشرف
    $full_name = trim($_POST["full_name"] ?? "");
    $email = trim($_POST["email"] ?? "");
    $phone = trim($_POST["phone"] ?? "");
    $specialization = trim($_POST["specialization"] ?? "");

    // التحقق من الحقول المطلوبة وصحة البريد إذا تم إدخاله
    if (
        $full_name !== "" &&
        ($email === "" || filter_var($email, FILTER_VALIDATE_EMAIL))
    ) {

        // إضافة المشرف إلى قاعدة البيانات
        $stmt = $conn->prepare(
            "INSERT INTO supervisors
            (full_name, email, phone, specialization)
            VALUES
            (:full_name, :email, :phone, :specialization)"
        );

        $stmt->execute([
            ":full_name" => $full_name,
            ":email" => $email !== "" ? $email : null,
            ":phone" => $phone,
            ":specialization" => $specialization
        ]);

        // الانتقال إلى صفحة عرض المشرفين
        header("Location: supervisors.php");
        exit;

    } else {
        $error = "تأكد من كتابة اسم المشرف والبريد الإلكتروني بشكل صحيح.";
    }
}
?>

