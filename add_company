<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// متغير لعرض رسالة للمستخدم
$message = "";

// التحقق من إرسال النموذج
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استقبال بيانات جهة التدريب
    $company_name = trim($_POST["company_name"] ?? "");
    $contact_person = trim($_POST["contact_person"] ?? "");
    $email = trim($_POST["email"] ?? "");
    $phone = trim($_POST["phone"] ?? "");
    $city = trim($_POST["city"] ?? "");

    // التأكد من إدخال اسم الشركة
    if ($company_name === "") {

        $message = "فضلاً أدخل اسم جهة التدريب.";

    } else {

        try {
            // تجهيز أمر إضافة جهة التدريب
            $sql = "INSERT INTO training_companies
                    (company_name, contact_person, email, phone, city)
                    VALUES
                    (:company_name, :contact_person, :email, :phone, :city)";

            $stmt = $conn->prepare($sql);

            // حفظ البيانات في قاعدة البيانات
            $stmt->execute([
                ":company_name" => $company_name,
                ":contact_person" => $contact_person,
                ":email" => $email,
                ":phone" => $phone,
                ":city" => $city
            ]);

            $message = "تمت إضافة جهة التدريب بنجاح ✅";

        } catch (PDOException $e) {

            $message = "حدث خطأ أثناء حفظ البيانات.";
        }
    }
}
?>

