
<?php
// الاتصال بقاعدة البيانات
require_once "db.php";

// جلب الطلاب من قاعدة البيانات
$stmt = $conn->query(
    "SELECT student_id, full_name FROM students ORDER BY full_name"
);
$students = $stmt->fetchAll(PDO::FETCH_ASSOC);

// جلب المشرفين من قاعدة البيانات
$stmt = $conn->query(
    "SELECT supervisor_id, full_name FROM supervisors ORDER BY full_name"
);
$supervisors = $stmt->fetchAll(PDO::FETCH_ASSOC);

// عند إرسال نموذج التقييم
if ($_SERVER["REQUEST_METHOD"] === "POST") {

    // استلام البيانات
    $student_id = (int) ($_POST["student_id"] ?? 0);
    $supervisor_id = (int) ($_POST["supervisor_id"] ?? 0);
    $score = $_POST["evaluation_score"] ?? "";
    $comments = trim($_POST["comments"] ?? "");
    $evaluation_date = $_POST["evaluation_date"] ?? "";

    // التحقق من صحة الدرجة والتاريخ
    if (
        $student_id > 0 &&
        $supervisor_id > 0 &&
        $score !== "" &&
        is_numeric($score) &&
        (float) $score >= 0 &&
        (float) $score <= 100 &&
        $evaluation_date !== ""
    ) {

        // حفظ التقييم في قاعدة البيانات
        $stmt = $conn->prepare(
            "INSERT INTO evaluations
            (student_id, supervisor_id, evaluation_score,
             comments, evaluation_date)
            VALUES
            (:student_id, :supervisor_id, :score,
             :comments, :evaluation_date)"
        );

        $stmt->execute([
            ":student_id" => $student_id,
            ":supervisor_id" => $supervisor_id,
            ":score" => $score,
            ":comments" => $comments,
            ":evaluation_date" => $evaluation_date
        ]);

        // الانتقال إلى صفحة عرض التقييمات
        header("Location: evaluations.php");
        exit;

    } else {
        $error = "تأكد من اختيار الطالب والمشرف وإدخال درجة من 0 إلى 100 والتاريخ.";
    }
}
